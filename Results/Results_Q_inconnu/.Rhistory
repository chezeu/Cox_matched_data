library(reclin2)
library(dplyr)
#library(RecordLinkage)
#  Préparation des données
set.seed(123)
df_A <- data.frame(
id = 1:50,
nom = c("Dupont", "Martin", "Durand", sample(c("Dupont", "Martin", "Durand", "Dubois", "Leroy"), 97, replace = TRUE)),
prenom = c("Jean", "Pierre", "Marie", sample(c("Jean", "Pierre", "Marie", "Sophie", "Thomas"), 97, replace = TRUE)),
age = sample(18:80, 100, replace = TRUE),
ville = sample(c("Paris", "Lyon", "Marseille", "Toulouse", "Lille"), 100, replace = TRUE),
stringsAsFactors = FALSE
)
########################################################
# data generation of the bigger data base
# prevalence== proba for matching variables
K=5
nA=50
nB=100
beta=c(0.5,-0.5,1)
prevalence=rep(0.5,K)
min_prev=0.02
# First database B with matching variables
datB = matrix(0, nrow = nB, ncol = K+1)
conditionB = TRUE
while (conditionB){
datB[,1:K] = sapply(prevalence, function(x){rbinom(nB, size = 1,prob = x)})
conditionB = (sum(colSums(datB[,1:K]/nB) >= min_prev) < K)
}
datB = data.frame(datB)
colnames(datB)=c(paste("R", 1:K, sep = ""),"id")
# database A with matching variables
idBA <- sample(1:nB,nA) #ident in A appearing in B
datA <- datB[idBA,]
datA[,K+1] = 1:nA #id
datB[,K+1] = (nA+1):(nA+nB)
########### record linkage############
library(reclin2) # pour la fonction pair_blocking
# pairs with same blocking variable
datA$block = rep(1,nrow(datA))#variable suplementaire de blocking
datB$block = rep(1,nrow(datB))
paires <- pair_blocking(x=datA, y=datB,
on = "block")
#  comparison
paires <- compare_pairs ( paires,
on = c("R1","R2","R3","R4","R5"),
default_comparator = identical())
## classification
model <- problink_em ( ~ R1+R2+R3+R4+R5, data=paires)
#estimation de mpost
paires_compar <- predict(model, paires, type ="mpost", add = TRUE, binary = TRUE)
#formation de la matrice de proba
Q= t(matrix(paires_compar$mpost,ncol=nrow(datA),nrow=nrow(datB)))
# Sélection des paires avec un seuil de probabilité
paires_finales <- select_threshold(
paires_compar ,
variable="selected",
threshold = 0.75,  # Seuil de probabilité (à ajuster)
score = "mpost",
x = datA,
y = datB
)
#les matches obtenus
BASE= paires_finales [which(paires_finales$selected==TRUE )]
View(BASE)
