)
df_B <- data.frame(
id = 101:200,
nom = c("Dupond", "Martine", "Durand", sample(c("Dupond", "Martine", "Durand", "Dubois", "Leroy"), 97, replace = TRUE)),
prenom = c("Jean", "Pier", "Marie", sample(c("Jean", "Pier", "Marie", "Sophie", "Thomas"), 97, replace = TRUE)),
age = sample(18:80, 100, replace = TRUE) + sample(-2:2, 100, replace = TRUE),
ville = sample(c("Paris", "Lyon", "Marseille", "Toulouse", "Lille"), 100, replace = TRUE),
stringsAsFactors = FALSE
)
# Étape de blocage
paires <- pair_blocking(
x = df_A,
y = df_B,
on = "ville") # sinon, rajouter pour chacune des bases
#  Comparaison des paires
paires_comparées<- compare_pairs(
pairs = paires,
on = c("ville", "nom", "prenom", "age"),
comparators = list(
ville= identical(),
nom = jaro_winkler(0.85),  # seuil de Similarité pour les noms
prenom = jaro_winkler(0.8), # seuil de Similarité pour les prénoms
age = identical()
)
)
modele <- problink_em( ~ ville+nom + prenom + age, data = paires_comparées)
paires_scorées <- predict(modele, paires_comparées, type ="mpost", add = TRUE, binary = TRUE)
View(paires_scorées)
# Sélection des paires avec un seuil de probabilité
paires_finales <- select_threshold(
paires_scorées ,
variable="selected",
threshold = 0.85,  # Seuil de probabilité (à ajuster)
score = "mpost",
x = df_A,
y = df_B
)
View(paires_finales)
# Création du dataframe couplé
donnees_couplees <- link(
paires_finales,
selection = NULL,  # Méthode de sélection
x = df_A,
y = df_B
)
